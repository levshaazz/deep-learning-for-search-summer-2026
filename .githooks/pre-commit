#!/bin/sh
# Страховка к наблюдателю: если в коммит попадает прогнанная тетрадка, дамп из её вывода
# вынимается автоматически и едет ТЕМ ЖЕ коммитом. Без этого дамп и проза расходились —
# тетрадка с новыми числами уже в истории, а seminars/runs/*.json ещё со старыми, и G29
# сверял прозу со вчерашним прогоном, не сказав ни слова.
#
# Хук НИЧЕГО не блокирует: нет дампа — молча пропускаем. Гейт G29 живёт отдельно.
# Ставится через `npm run hooks:install` (копией в .git/hooks, чтобы не трогать core.hooksPath:
# на нём висят хуки Git LFS, и их подмена сломала бы выкачку больших файлов).

nbs=$(git diff --cached --name-only --diff-filter=ACM -- 'seminars/*.ipynb')
[ -z "$nbs" ] && exit 0

root=$(git rev-parse --show-toplevel)

# Пути собираем в позиционные параметры, а не подстановкой в строку: каталог репозитория
# содержит пробелы («Deep Learning for Search [Summer 2026]»), и на первой редакции хука
# каждый путь разваливался на четыре аргумента — хук отрабатывал вхолостую и молчал.
IFS='
'
set --
for f in $nbs; do set -- "$@" "$root/$f"; done
unset IFS

python3 "$root/scripts/extract_runs.py" --quiet "$@" || exit 0
# По одному каталогу и только существующие: `git add A B`, где B ещё не создан, падает
# ЦЕЛИКОМ и не добавляет даже A. Каталога runs-t4 нет до первого прогона на ускорителе —
# на этом хук и терял дамп, добавляя в коммит одну тетрадку без её чисел.
for d in "$root/seminars/runs" "$root/seminars/runs-t4"; do
  [ -d "$d" ] && git add "$d"
done
exit 0
