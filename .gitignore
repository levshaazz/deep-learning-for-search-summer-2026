# Secrets — never commit the API key
.env
_research/.charsheet_ref.txt

# ── Internal working docs — must NOT reach students (public repo) ───────────
# All internal plans / audits / remediation notes live here, gitignored.
/_internal/

# ── Local manim sketchpad (storyboard only — NEVER ships; output stays local).
/_sketch/

# ── Generated from canonical Lectures/{css,js} by Lectures Template/sync-shared.mjs.
# Edit the canonical Lectures/{css,js}, NOT these — they are regenerated at build.
/Lectures Template/css/
/Lectures Template/js/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Node / tooling
node_modules/
_audit/node_modules/

# Python bytecode cache (generators / facts-gate)
__pycache__/
*.pyc

# Heavy local artifacts — not part of the published course
_audit/shots/
_audit/shots-*/
_eval_cnn/

# Generated offline bundles (rebuild with build-standalone.mjs)
# Uncomment to keep them out of git if they get large:
# *(Standalone).html

# Classic offline widget bundles for decks (regenerate: node widgets/build-deck-bundle.mjs <id>)
/widgets/_dist/

# Sharded lecture decks: the shipped Lectures/NN-*.html is BUILD OUTPUT, reassembled
# byte-identically from its Lectures/<slug>/parts/*.html fragments (the tracked source)
# by `npm run build` (scripts/assemble-deck.mjs build). Edit the fragments, not these.
/Lectures/[0-9][0-9]-*.html

# R8 deck auto-layout global: BUILD OUTPUT — esbuild widgets/_layout.js → window.DeckLayout
# by `npm run build` (scripts/build-deck-layout.mjs). Single source is widgets/_layout.js.
/Lectures/js/layout.js

# Sharded Book chapters: content/book/lN.js is BUILD OUTPUT, reassembled byte-identically
# from its content/book/<stem>/beats/*.js fragments (the tracked source) by `npm run build`
# (scripts/assemble-chapter.mjs build). Edit the beat fragments, not these.
/content/book/l*.js

# Scratch QA contact sheets (regenerable)
Lectures/assets/img/_contact/

# Autonomous iteration harness — heavy/local artifacts (keep canon .md tracked)
_research/iterations/session_*/
_research/iterations/backups/
_research/iterations/harness.log
_research/iterations/STATUS

# Generated detector self-test fixtures (regenerated each run)
_audit/fixtures/

# Golden-screenshot regression baselines (local, regenerable via golden.mjs --approve)
_audit/golden/
_audit/golden-cur/

# Throwaway visual-gate self-test fixture (deleted after each run)
Lectures/_vg-selftest.html

# ── Site build system (Astro) ──────────────────────────────────────────────
node_modules/
dist/
.astro/
.vercel/
.netlify/
# GitHub Pages publishes via the deploy workflow (Actions), which rebuilds docs/
# in CI. The build output is regenerable, so it is NOT tracked.
docs/

# ── Heavy / legacy artifacts not part of the published site ────────────────
# (inline comments are NOT allowed on gitignore pattern lines)
# legacy reference PDFs (~38MB) — kept locally, not published
old_slides/
# stray 8MB offline eval artifact
cnn_autoencoders_offline.html
# QA test artifact (regenerable)
_audit/deck.pdf
# generated by build-standalone.mjs (heavy, regenerable)
*(Standalone).html

# ── Temp / obsolete — local only, not published ────────────────────────────
# empty scratch
to_do.md
# scratch example (the real generator is _research/gen_images.py)
image_generation_example.py
# superseded planning doc (work landed in _research/iterations/ + the build)
WBW_POLISH_PLAN.md
# duplicate of Lectures/assets/me.jpeg (the site uses that copy)
/me.jpeg

# GloVe download cache for gen_l5.py (heavy, regenerable)
/_research/data/.cache/
