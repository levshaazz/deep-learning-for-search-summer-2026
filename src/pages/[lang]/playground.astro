---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, t, localizedPath } from '../../i18n/locales.js';
import { ui } from '../../i18n/ui.js';
import { buildDemos, groupDemos, lectureFacets, topicFacets, GROUPS, TOPIC_LIST } from '../../lib/playground.js';

// widget styles (bundled globally) + shared widget base — same auto-discovery as the Book renderer:
// dropping a `widgets/<id>/style.css` is picked up here with zero edits (eager glob → side effect).
import '../../../widgets/_base.css';
const widgetStyles = import.meta.glob('../../../widgets/*/style.css', { eager: true });
void widgetStyles;

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const { lang } = Astro.params;
const showFallbackNotice = lang === 'tt';

// DATA-DRIVEN: enumerate every auto-registered widget (buildDemos reuses WIDGET_META + DATA from
// widgets.js, which globs widgets/*/manifest.json). A widget added later (e.g. tokenizer-compare)
// appears here automatically — no hardcoded list. Group by lecture for the section headings; the
// toolbar facets on BOTH lecture AND topic (the concept taxonomy), plus free-text search.
const demos = buildDemos();
const groups = groupDemos(demos);

// Facets present in this build (chips render only for lectures/topics that actually have widgets).
const lecFacets = lectureFacets(demos);
const topFacets = topicFacets(demos);
const totalDemos = demos.length;

// Trilingual lookup for a lecture/topic id → its localized label (for the per-card chip + searchable
// text). Built from the same GROUPS / TOPIC_LIST the lib exports, so it stays in sync automatically.
const lecTitle = (id) => {
  const g = GROUPS.find((g) => g.id === id);
  return g ? t(g.title, lang) : (id === 'extras' ? t({ en: 'More demos', ru: 'Другие демо', tt: 'Башка демолар' }, lang) : `L${id}`);
};
const topTitle = (id) => {
  const tp = TOPIC_LIST.find((x) => x.id === id);
  return tp ? t(tp.title, lang) : id;
};
// The lecture facet key a demo belongs to (mirrors groupDemos' bucketing: unknown → 'extras').
const lecKeyOf = (d) => (GROUPS.some((g) => g.id === d.lecture) ? d.lecture : 'extras');
// A card's searchable text (title + topic + lecture label) in the active language, lower-cased.
const searchText = (d) =>
  [t(d.title, lang), topTitle(d.topic), lecKeyOf(d) === 'extras' ? '' : `L${lecKeyOf(d)}`, lecTitle(lecKeyOf(d))]
    .filter(Boolean).join(' ').toLowerCase();

// Resolve each widget's flat i18n map to THIS locale (mirrors the Book: meta.i18n → t(v, lang)),
// then build the client payload the transport mounts with (same { data, labels } shape the Book uses).
// The two status-pill labels travel in the payload so the transport never has to scrape them from DOM.
const payload = {
  pill: { playing: t(ui.labels.statusPlaying, lang), paused: t(ui.labels.statusPaused, lang) },
  demos: demos.map((d) => {
    const labels = Object.fromEntries(Object.entries(d.i18n).map(([k, v]) => [k, t(v, lang)]));
    return {
      id: d.id,
      mountName: d.mountName,
      data: d.data,
      labels: { ...labels, role: 'img' },
      maxStep: d.maxStep,
    };
  }),
};
---
<BaseLayout lang={lang} page="playground" title={t(ui.nav.playground, lang)}>
  <div class="wrap">
    <section class="block">
      <h2>{t(ui.sections.playground, lang)}</h2>
      <div class="kicker">{t(ui.sections.playgroundKicker, lang)}</div>
      {showFallbackNotice && <p class="notice">{t(ui.translationInProgress, lang)}</p>}
      <p class="lead">{t(ui.sections.playgroundIntro, lang)}</p>
    </section>

    {/* Sticky filter/search toolbar: LECTURE chips + TOPIC chips + free-text search. All controls are
        keyboard-accessible (chips are <button>s, the search is a labeled <input>). The client wires
        show/hide of .pg-card by data-lecture / data-topic / data-search, composing with lazy-mount
        (a hidden card never mounts; revealing one mounts it on scroll). */}
    <div class="pg-toolbar" role="search" aria-label={t(ui.playgroundFilter.searchLabel, lang)}>
      <div class="pg-facet">
        <span class="pg-facet-label">{t(ui.playgroundFilter.byLecture, lang)}</span>
        <div class="pg-chips" role="group" aria-label={t(ui.playgroundFilter.byLecture, lang)}>
          <button type="button" class="pg-chip is-on" data-facet="lecture" data-val="" aria-pressed="true">{t(ui.playgroundFilter.all, lang)}</button>
          {lecFacets.map((f) => (
            <button type="button" class="pg-chip" data-facet="lecture" data-val={f.id} aria-pressed="false">
              {f.id === 'extras' ? t(f.title, lang) : `L${f.id}`}<span class="pg-chip-n">{f.count}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="pg-facet">
        <span class="pg-facet-label">{t(ui.playgroundFilter.byTopic, lang)}</span>
        <div class="pg-chips" role="group" aria-label={t(ui.playgroundFilter.byTopic, lang)}>
          <button type="button" class="pg-chip is-on" data-facet="topic" data-val="" aria-pressed="true">{t(ui.playgroundFilter.all, lang)}</button>
          {topFacets.map((f) => (
            <button type="button" class="pg-chip" data-facet="topic" data-val={f.id} aria-pressed="false">
              {t(f.title, lang)}<span class="pg-chip-n">{f.count}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="pg-toolbar-row">
        <label class="pg-search-wrap">
          <span class="visually-hidden">{t(ui.playgroundFilter.searchLabel, lang)}</span>
          <input type="search" class="pg-search" id="pg-search"
                 placeholder={t(ui.playgroundFilter.searchPlaceholder, lang)}
                 aria-label={t(ui.playgroundFilter.searchLabel, lang)} autocomplete="off" />
        </label>
        <span class="pg-showing" aria-live="polite"
              data-tpl={t(ui.playgroundFilter.showing, lang)} data-total={totalDemos}>{
          t(ui.playgroundFilter.showing, lang).replace('{n}', String(totalDemos)).replace('{m}', String(totalDemos))
        }</span>
        <button type="button" class="pg-clear" id="pg-clear" hidden>{t(ui.playgroundFilter.clear, lang)}</button>
      </div>
    </div>

    <p class="pg-empty" id="pg-empty" hidden>{t(ui.playgroundFilter.none, lang)}</p>

    {groups.map((g) => (
      <section class="block pg-group" data-lecture-group={g.id}>
        <h3 class="pg-group-title">{t(g.title, lang)}</h3>
        <div class="pg-grid">
          {g.items.map((d) => (
            <figure class="pg-card" data-demo={d.id} data-max={d.maxStep}
                    data-lecture={lecKeyOf(d)} data-topic={d.topic} data-search={searchText(d)}
                    data-mounted="false" tabindex="0">
              <figcaption class="pg-head">
                <span class="pg-title">{t(d.title, lang)}</span>
                <span class="pg-pill" data-pill="paused" aria-live="polite">{t(ui.labels.statusPaused, lang)}</span>
              </figcaption>

              <div class="pg-meta">
                <span class="pg-tag pg-tag-lec">{lecKeyOf(d) === 'extras' ? lecTitle('extras') : `L${lecKeyOf(d)}`}</span>
                <span class="pg-tag pg-tag-topic">{topTitle(d.topic)}</span>
              </div>

              <div class="pg-stage">
                <div class="pg-mount" id={`pg-${d.id}`}></div>
                <div class="pg-placeholder" aria-hidden="true">
                  <span class="pg-skeleton"></span>
                  <span class="pg-mounting">{t(ui.labels.mounting, lang)}</span>
                </div>
              </div>

              <div class="pg-transport" role="group" aria-label={t(ui.sections.playground, lang)}>
                <button type="button" class="pg-btn" data-act="restart" title={t(ui.labels.restart, lang)} aria-label={t(ui.labels.restart, lang)}>⤺</button>
                <button type="button" class="pg-btn" data-act="prev" title={t(ui.labels.stepBack, lang)} aria-label={t(ui.labels.stepBack, lang)}>‹</button>
                <button type="button" class="pg-btn pg-play" data-act="play" title={t(ui.labels.play, lang)} aria-label={t(ui.labels.play, lang)}>
                  <span class="pg-ico-play">▶</span><span class="pg-ico-pause">❚❚</span>
                </button>
                <button type="button" class="pg-btn" data-act="next" title={t(ui.labels.stepFwd, lang)} aria-label={t(ui.labels.stepFwd, lang)}>›</button>
                <input type="range" class="pg-scrub" min="0" max={d.maxStep} value="0" step="1"
                       aria-label={t(ui.labels.stepSlider, lang)} title={t(ui.labels.stepSlider, lang)} />
                <span class="pg-count" aria-hidden="true"><b class="pg-k">0</b>&#8202;/&#8202;<span class="pg-n">{d.maxStep}</span></span>
              </div>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script type="application/json" id="pg-payload" set:html={JSON.stringify(payload)}></script>
  <!-- The transport runtime lives in its own module (src/scripts/playground-client.js): a page
       <script> that imports it links reliably, whereas a hoisted inline script using only
       import.meta.glob can be dropped on a [lang] static route. It reads #pg-payload, mounts each
       widget the Book's way (glob logic.js → export → fn(el,{data,labels}) → setStep), and wires
       the free-play transport. -->
  <script>
    import '../../scripts/playground-client.js';
  </script>

  <style is:global>
    /* Standalone mounts SHOW their own caption/counter; in the lab the transport owns stepping, so
       hide the factory's caption/counter chrome (the slider + counter replace them). */
    .pg-mount .wgt-caption, .pg-mount .wgt-counter,
    .pg-mount .cs-caption, .pg-mount .cs-counter { display: none; }

    /* ── CONTENT-DRIVEN STAGE for the DOM-flow stepped widgets ────────────────
       tokenizer-compare and inverted-index reveal their steps by toggling `is-hidden`
       on BLOCK rows (opacity only — the rows stay in flow), so at step 0 the mount
       reserves the FULL final-step height and leaves ~1000px of blank below the
       step-0 content. In the lab (where the transport, not a scroll column, drives
       stepping) we collapse a hidden row's LAYOUT height so the stage sizes to the
       step on screen. A short max-height transition (matched to the widget's own
       opacity fade) keeps stepping smooth — no snap, no void.
       Scoped to .pg-mount so the Book/slide renderers (which need the reserved
       height for sticky-scroll stepping) are untouched. SVG-based widgets are
       unaffected: their height is real geometry inside a fixed-aspect viewBox. */
    .pg-mount .tc-row, .pg-mount .ix-prow, .pg-mount .ix-merge {
      max-height: 60vh;
      overflow: hidden;
      transition: opacity var(--dur, 220ms) var(--ease), transform var(--dur, 220ms) var(--ease),
                  max-height var(--dur, 220ms) var(--ease), margin var(--dur, 220ms) var(--ease),
                  padding var(--dur, 220ms) var(--ease);
    }
    .pg-mount .tc-row.is-hidden, .pg-mount .ix-prow.is-hidden, .pg-mount .ix-merge.is-hidden {
      max-height: 0; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0;
      border-width: 0;
    }
    /* The inverted-index per-doc "hit" marks live inside grid cards that are always
       visible; only their dots fade in. The postings/merge regions are the tall
       reserved blocks — collapsing those (above) removes the void without touching
       the doc grid. */
    @media (prefers-reduced-motion: reduce) {
      .pg-mount .tc-row, .pg-mount .ix-prow, .pg-mount .ix-merge { transition: none; }
    }
  </style>

  <style>
    .lead { font-size: var(--fz-lead); color: var(--ink-2); max-width: var(--ws-measure); }

    /* Accessible-but-visually-hidden label text (for the search input's <label>). */
    .visually-hidden {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }

    /* ── Sticky filter/search toolbar (lab-instrument styling) ────────────────── */
    .pg-toolbar {
      position: sticky; top: 0; z-index: 20;
      display: flex; flex-direction: column; gap: var(--ws-2);
      padding: var(--ws-2) var(--ws-3); margin-bottom: var(--ws-3);
      background: var(--bg-alt); border: var(--hairline) solid var(--rule); border-radius: var(--r-md);
      box-shadow: var(--shadow-sm);
      backdrop-filter: saturate(140%) blur(4px);
    }
    .pg-facet { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--ws-1) var(--ws-2); }
    .pg-facet-label {
      flex: none; font-family: var(--font-mono); font-size: var(--fz-tiny); font-weight: 700;
      letter-spacing: 1.5px; text-transform: uppercase; color: var(--ink-3); min-width: 4.5em;
    }
    .pg-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .pg-chip {
      display: inline-flex; align-items: center; gap: 5px; cursor: pointer;
      font-family: var(--font-mono); font-size: var(--fz-tiny); line-height: 1;
      padding: 5px 10px; border-radius: var(--r-pill);
      color: var(--ink-2); background: var(--bg-card); border: var(--hairline) solid var(--rule);
      transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease),
                  border-color var(--dur-fast) var(--ease);
    }
    .pg-chip:hover { background: var(--bg-inset); color: var(--ink); }
    .pg-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .pg-chip.is-on {
      color: var(--c-green-ink); background: var(--c-green-soft); border-color: var(--c-green);
      font-weight: 700;
    }
    .pg-chip-n {
      font-size: 0.85em; opacity: 0.7; font-variant-numeric: tabular-nums;
      padding-left: 4px; border-left: var(--hairline) solid currentColor;
    }
    .pg-toolbar-row {
      display: flex; align-items: center; flex-wrap: wrap; gap: var(--ws-2);
      padding-top: var(--ws-1); border-top: var(--hairline) solid var(--rule);
    }
    .pg-search-wrap { flex: 1 1 240px; min-width: 0; display: block; }
    .pg-search {
      width: 100%; box-sizing: border-box; font-family: var(--font-sans, inherit); font-size: var(--fz-small);
      padding: 7px 12px; border-radius: var(--r-sm);
      color: var(--ink); background: var(--bg-card); border: var(--hairline) solid var(--rule);
    }
    .pg-search:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .pg-showing {
      flex: none; font-family: var(--font-mono); font-size: var(--fz-tiny); color: var(--ink-3);
      font-variant-numeric: tabular-nums; white-space: nowrap;
    }
    .pg-clear {
      flex: none; cursor: pointer; font-family: var(--font-mono); font-size: var(--fz-tiny);
      padding: 6px 12px; border-radius: var(--r-sm);
      color: var(--ink-2); background: var(--bg-card); border: var(--hairline) solid var(--rule);
      transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
    }
    .pg-clear:hover { background: var(--bg-inset); color: var(--ink); }
    .pg-clear:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .pg-empty { font-style: italic; color: var(--ink-3); padding: var(--ws-3) 0; }

    /* Hidden by filter — these cards never mount (the client only observes visible cards). */
    .pg-card[hidden] { display: none; }
    .pg-group[hidden] { display: none; }

    .pg-group { border-bottom: var(--hairline) solid var(--rule); }
    .pg-group-title {
      font-family: var(--font-mono); font-size: var(--fz-small); letter-spacing: 1px;
      color: var(--warm-ink); margin: 0 0 var(--ws-3); padding-bottom: 6px;
      border-bottom: var(--hairline) solid var(--rule);
    }

    /* Lab grid: wide cards so the figures breathe; never overflows (min(100%, …)). */
    .pg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
      gap: var(--ws-3); }

    .pg-card {
      display: flex; flex-direction: column; margin: 0;
      background: var(--bg-card); border: var(--hairline) solid var(--rule);
      border-radius: var(--r-md); overflow: hidden; box-shadow: var(--shadow-sm);
    }
    .pg-card.is-playing { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), var(--shadow-sm); }

    /* Card header: title + a lab-instrument status pill (mono, uppercase). */
    .pg-head {
      display: flex; align-items: center; justify-content: space-between; gap: var(--ws-2);
      padding: var(--ws-2) var(--ws-3); border-bottom: var(--hairline) solid var(--rule);
    }
    .pg-title { font-family: var(--font-serif); font-size: var(--fz-h3); font-weight: 600;
      color: var(--ink); line-height: 1.2; }
    .pg-pill {
      flex: none; font-family: var(--font-mono); font-size: var(--fz-tiny); font-weight: 700;
      letter-spacing: 1.5px; text-transform: uppercase; padding: 3px 10px; border-radius: var(--r-pill);
      color: var(--ink-3); background: var(--bg-inset); border: var(--hairline) solid var(--rule);
      white-space: nowrap;
    }
    .pg-pill[data-pill="playing"] {
      color: var(--c-green-ink); background: var(--c-green-soft); border-color: var(--c-green);
    }

    /* Per-card facet badges (lecture + topic) — the visible echo of the two filter dimensions. */
    .pg-meta {
      display: flex; flex-wrap: wrap; gap: 6px; padding: var(--ws-1) var(--ws-3) 0;
    }
    .pg-tag {
      font-family: var(--font-mono); font-size: var(--fz-tiny); line-height: 1.3;
      padding: 2px 8px; border-radius: var(--r-pill);
      border: var(--hairline) solid var(--rule); color: var(--ink-3); background: var(--bg-inset);
    }
    .pg-tag-lec { color: var(--warm-ink); }

    /* Stage: the SAME card surface every widget paints its own panel/SVG with (--bg-card), so the
       stage and the widget panel read as ONE consistent surface in BOTH themes. (A hardcoded #fff
       stage left the token-themed widgets that paint their own dark --bg-card panel — contrastive-
       space, attention-e2e, residual-stream — sitting as dark "islands" on a white stage in dark
       mode; tracking the token unifies the grid and keeps every widget legible in light + dark.)
       align-items:flex-start so a content-driven (collapsed-step) widget pins to the top rather than
       floating mid-stage as it grows/shrinks across steps. */
    .pg-stage {
      position: relative;
      background: var(--bg-card); padding: var(--ws-3); display: flex; align-items: flex-start;
      justify-content: center; min-height: 220px; overflow: hidden;
    }
    .pg-mount { width: 100%; max-width: 100%; }
    .pg-mount :global(svg), .pg-mount :global(img) { max-width: 100%; height: auto; }

    /* Lazy-mount placeholder: a light skeleton + "mounting…" label shown until the card's widget
       scrolls into view and the client mounts it. The client sets the card's data-mounted="true",
       which hides this overlay. Cards filtered out (and thus never observed) keep the placeholder. */
    .pg-placeholder {
      position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: var(--ws-2); pointer-events: none; background: var(--bg-card);
    }
    .pg-card[data-mounted="true"] .pg-placeholder { display: none; }
    .pg-skeleton {
      width: 64%; max-width: 220px; height: 56px; border-radius: var(--r-sm);
      background: linear-gradient(100deg, var(--bg-inset) 30%, var(--bg-alt) 50%, var(--bg-inset) 70%);
      background-size: 200% 100%; animation: pg-shimmer 1.4s linear infinite;
    }
    .pg-mounting {
      font-family: var(--font-mono); font-size: var(--fz-tiny); letter-spacing: 1px;
      color: var(--ink-3);
    }
    @keyframes pg-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
    @media (prefers-reduced-motion: reduce) {
      .pg-skeleton { animation: none; }
    }

    /* Transport: a row of square mono buttons + a scrub slider + a mono step counter. */
    .pg-transport {
      display: flex; align-items: center; gap: var(--ws-1); padding: var(--ws-2) var(--ws-3);
      border-top: var(--hairline) solid var(--rule); background: var(--bg-alt);
    }
    .pg-btn {
      flex: none; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--font-mono); font-size: 0.95rem; line-height: 1; cursor: pointer;
      color: var(--ink-2); background: var(--bg-card); border: var(--hairline) solid var(--rule);
      border-radius: var(--r-sm); transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
    }
    .pg-btn:hover { background: var(--bg-inset); color: var(--ink); }
    .pg-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .pg-play { color: var(--accent); }
    .pg-ico-pause { display: none; }
    .is-playing .pg-ico-play { display: none; }
    .is-playing .pg-ico-pause { display: inline; }

    .pg-scrub { flex: 1 1 auto; min-width: 40px; accent-color: var(--accent); cursor: pointer; height: 4px; }
    .pg-count {
      flex: none; font-family: var(--font-mono); font-size: var(--fz-small); color: var(--ink-3);
      font-variant-numeric: tabular-nums; white-space: nowrap; min-width: 3ch; text-align: right;
    }
    .pg-count .pg-k { color: var(--ink); font-weight: 700; }

    @media (max-width: 480px) {
      .pg-btn { width: 30px; height: 30px; }
      .pg-stage { min-height: 180px; padding: var(--ws-2); }
    }
  </style>
</BaseLayout>
