---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, t, localizedPath } from '../../i18n/locales.js';
import { ui } from '../../i18n/ui.js';
import { buildDemos, groupDemos } from '../../lib/playground.js';

// widget styles (bundled globally) + shared widget base — same auto-discovery as the Book renderer:
// dropping a `widgets/<id>/style.css` is picked up here with zero edits (eager glob → side effect).
import '../../../widgets/_base.css';
const widgetStyles = import.meta.glob('../../../widgets/*/style.css', { eager: true });
void widgetStyles;

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const { lang } = Astro.params;
const showFallbackNotice = lang === 'tt';

// DATA-DRIVEN: enumerate every auto-registered widget (buildDemos reuses WIDGET_META + DATA from
// widgets.js, which globs widgets/*/manifest.json). A widget added later (e.g. tokenizer-compare)
// appears here automatically — no hardcoded list. Group by lecture for the section headings.
const demos = buildDemos();
const groups = groupDemos(demos);

// Resolve each widget's flat i18n map to THIS locale (mirrors the Book: meta.i18n → t(v, lang)),
// then build the client payload the transport mounts with (same { data, labels } shape the Book uses).
// The two status-pill labels travel in the payload so the transport never has to scrape them from DOM.
const payload = {
  pill: { playing: t(ui.labels.statusPlaying, lang), paused: t(ui.labels.statusPaused, lang) },
  demos: demos.map((d) => {
    const labels = Object.fromEntries(Object.entries(d.i18n).map(([k, v]) => [k, t(v, lang)]));
    return {
      id: d.id,
      mountName: d.mountName,
      data: d.data,
      labels: { ...labels, role: 'img' },
      maxStep: d.maxStep,
    };
  }),
};
---
<BaseLayout lang={lang} page="playground" title={t(ui.nav.playground, lang)}>
  <div class="wrap">
    <section class="block">
      <h2>{t(ui.sections.playground, lang)}</h2>
      <div class="kicker">{t(ui.sections.playgroundKicker, lang)}</div>
      {showFallbackNotice && <p class="notice">{t(ui.translationInProgress, lang)}</p>}
      <p class="lead">{t(ui.sections.playgroundIntro, lang)}</p>
    </section>

    {groups.map((g) => (
      <section class="block pg-group">
        <h3 class="pg-group-title">{t(g.title, lang)}</h3>
        <div class="pg-grid">
          {g.items.map((d) => (
            <figure class="pg-card" data-demo={d.id} data-max={d.maxStep} tabindex="0">
              <figcaption class="pg-head">
                <span class="pg-title">{t(d.title, lang)}</span>
                <span class="pg-pill" data-pill="paused" aria-live="polite">{t(ui.labels.statusPaused, lang)}</span>
              </figcaption>

              <div class="pg-stage"><div class="pg-mount" id={`pg-${d.id}`}></div></div>

              <div class="pg-transport" role="group" aria-label={t(ui.sections.playground, lang)}>
                <button type="button" class="pg-btn" data-act="restart" title={t(ui.labels.restart, lang)} aria-label={t(ui.labels.restart, lang)}>⤺</button>
                <button type="button" class="pg-btn" data-act="prev" title={t(ui.labels.stepBack, lang)} aria-label={t(ui.labels.stepBack, lang)}>‹</button>
                <button type="button" class="pg-btn pg-play" data-act="play" title={t(ui.labels.play, lang)} aria-label={t(ui.labels.play, lang)}>
                  <span class="pg-ico-play">▶</span><span class="pg-ico-pause">❚❚</span>
                </button>
                <button type="button" class="pg-btn" data-act="next" title={t(ui.labels.stepFwd, lang)} aria-label={t(ui.labels.stepFwd, lang)}>›</button>
                <input type="range" class="pg-scrub" min="0" max={d.maxStep} value="0" step="1"
                       aria-label={t(ui.labels.stepSlider, lang)} title={t(ui.labels.stepSlider, lang)} />
                <span class="pg-count" aria-hidden="true"><b class="pg-k">0</b>&#8202;/&#8202;<span class="pg-n">{d.maxStep}</span></span>
              </div>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script type="application/json" id="pg-payload" set:html={JSON.stringify(payload)}></script>
  <!-- The transport runtime lives in its own module (src/scripts/playground-client.js): a page
       <script> that imports it links reliably, whereas a hoisted inline script using only
       import.meta.glob can be dropped on a [lang] static route. It reads #pg-payload, mounts each
       widget the Book's way (glob logic.js → export → fn(el,{data,labels}) → setStep), and wires
       the free-play transport. -->
  <script>
    import '../../scripts/playground-client.js';
  </script>

  <style is:global>
    /* Standalone mounts SHOW their own caption/counter; in the lab the transport owns stepping, so
       hide the factory's caption/counter chrome (the slider + counter replace them). */
    .pg-mount .wgt-caption, .pg-mount .wgt-counter,
    .pg-mount .cs-caption, .pg-mount .cs-counter { display: none; }
  </style>

  <style>
    .lead { font-size: var(--fz-lead); color: var(--ink-2); max-width: var(--ws-measure); }

    .pg-group { border-bottom: var(--hairline) solid var(--rule); }
    .pg-group-title {
      font-family: var(--font-mono); font-size: var(--fz-small); letter-spacing: 1px;
      color: var(--warm-ink); margin: 0 0 var(--ws-3); padding-bottom: 6px;
      border-bottom: var(--hairline) solid var(--rule);
    }

    /* Lab grid: wide cards so the figures breathe; never overflows (min(100%, …)). */
    .pg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
      gap: var(--ws-3); }

    .pg-card {
      display: flex; flex-direction: column; margin: 0;
      background: var(--bg-card); border: var(--hairline) solid var(--rule);
      border-radius: var(--r-md); overflow: hidden; box-shadow: var(--shadow-sm);
    }
    .pg-card.is-playing { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), var(--shadow-sm); }

    /* Card header: title + a lab-instrument status pill (mono, uppercase). */
    .pg-head {
      display: flex; align-items: center; justify-content: space-between; gap: var(--ws-2);
      padding: var(--ws-2) var(--ws-3); border-bottom: var(--hairline) solid var(--rule);
    }
    .pg-title { font-family: var(--font-serif); font-size: var(--fz-h3); font-weight: 600;
      color: var(--ink); line-height: 1.2; }
    .pg-pill {
      flex: none; font-family: var(--font-mono); font-size: var(--fz-tiny); font-weight: 700;
      letter-spacing: 1.5px; text-transform: uppercase; padding: 3px 10px; border-radius: var(--r-pill);
      color: var(--ink-3); background: var(--bg-inset); border: var(--hairline) solid var(--rule);
      white-space: nowrap;
    }
    .pg-pill[data-pill="playing"] {
      color: var(--c-green-ink); background: var(--c-green-soft); border-color: var(--c-green);
    }

    /* Stage: white canvas (the off-white widget art reads on it in both themes), like the gallery. */
    .pg-stage {
      background: #fff; padding: var(--ws-3); display: flex; align-items: center; justify-content: center;
      min-height: 220px; overflow: hidden;
    }
    .pg-mount { width: 100%; max-width: 100%; }
    .pg-mount :global(svg), .pg-mount :global(img) { max-width: 100%; height: auto; }

    /* Transport: a row of square mono buttons + a scrub slider + a mono step counter. */
    .pg-transport {
      display: flex; align-items: center; gap: var(--ws-1); padding: var(--ws-2) var(--ws-3);
      border-top: var(--hairline) solid var(--rule); background: var(--bg-alt);
    }
    .pg-btn {
      flex: none; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--font-mono); font-size: 0.95rem; line-height: 1; cursor: pointer;
      color: var(--ink-2); background: var(--bg-card); border: var(--hairline) solid var(--rule);
      border-radius: var(--r-sm); transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
    }
    .pg-btn:hover { background: var(--bg-inset); color: var(--ink); }
    .pg-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .pg-play { color: var(--accent); }
    .pg-ico-pause { display: none; }
    .is-playing .pg-ico-play { display: none; }
    .is-playing .pg-ico-pause { display: inline; }

    .pg-scrub { flex: 1 1 auto; min-width: 40px; accent-color: var(--accent); cursor: pointer; height: 4px; }
    .pg-count {
      flex: none; font-family: var(--font-mono); font-size: var(--fz-small); color: var(--ink-3);
      font-variant-numeric: tabular-nums; white-space: nowrap; min-width: 3ch; text-align: right;
    }
    .pg-count .pg-k { color: var(--ink); font-weight: 700; }

    @media (max-width: 480px) {
      .pg-btn { width: 30px; height: 30px; }
      .pg-stage { min-height: 180px; padding: var(--ws-2); }
    }
  </style>
</BaseLayout>
