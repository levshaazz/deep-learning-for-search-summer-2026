---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, t, withBase, localizedPath } from '../../../i18n/locales.js';
import { ui } from '../../../i18n/ui.js';
import { course } from '../../../lib/course.js';
import { WIDGET_META, DATA } from '../../../lib/widgets.js';
import l0 from '../../../../content/book/l0.js';
import l1 from '../../../../content/book/l1.js';
import l2 from '../../../../content/book/l2.js';
import l3 from '../../../../content/book/l3.js';
import l4 from '../../../../content/book/l4.js';
import l5 from '../../../../content/book/l5.js';

// widget styles (bundled globally) + shared widget base. Auto-discovered: dropping a
// widgets/<id>/style.css folder is picked up here with no edit (eager glob → side-effect imports).
import '../../../../widgets/_base.css';
const widgetStyles = import.meta.glob('../../../../widgets/*/style.css', { eager: true });
void widgetStyles; // referenced only for its bundling side effect

// NOTE: getStaticPaths runs in isolation and may reference only imports (not frontmatter consts).
export function getStaticPaths() {
  const ids = [l0.id, l1.id, l2.id, l3.id, l4.id, l5.id];
  return LOCALES.flatMap((lang) => ids.map((id) => ({ params: { lang, id } })));
}
const CHAPTERS = { '00': l0, '01': l1, '02': l2, '03': l3, '04': l4, '05': l5 };
const { lang, id } = Astro.params;
const chapter = CHAPTERS[id];
const lec = course.lectures.find((l) => l.id === id);
const showFallbackNotice = lang === 'tt';

// Resolve every beat for this locale; build the client payload (scrolly beats only).
const beats = chapter.beats.map((b) => {
  if (b.kind !== 'scrolly') return b;
  const meta = WIDGET_META[b.widget];
  const labels = Object.fromEntries(Object.entries(meta.i18n).map(([k, v]) => [k, t(v, lang)]));
  // beat-level labels (e.g. {mode:'tfidf'}) override the manifest i18n defaults.
  const merged = { ...labels, ...b.labels };
  const steps = meta.manifest.steps.map((s) => ({ step: s.step, label: merged[s.labelKey] || '' }));
  return { ...b, labels: merged, steps };
});
// widget id → exported mount-fn name. Source of truth is manifest.export; fall back to the
// deck-adapter's PascalCase rule (mount + PascalCase(id)) for widgets that omit it (e.g. cosine-sphere).
const pascalMount = (id) => 'mount' + id.split('-').map((s) => s[0].toUpperCase() + s.slice(1)).join('');
const WIDGET_EXPORTS = Object.fromEntries(
  Object.entries(WIDGET_META).map(([id, { manifest }]) => [id, manifest['export'] || pascalMount(id)])
);
const payload = {
  beats: beats.filter((b) => b.kind === 'scrolly')
    .map((b) => ({ id: b.id, widget: b.widget, data: DATA[b.data], labels: { ...b.labels, role: 'img' } })),
  exports: WIDGET_EXPORTS, // widget id → mount export name, resolved against the logic.js glob client-side
};
const proseText = (body) => (Array.isArray(body) ? body : [body]);

// ── inline markdown subset (rendered via set:html) ──────────────────────────
// Turns the authored markdown-ish strings (body[], heading, imgCaption) into
// safe HTML. NOT run on imgAlt (alt stays plain text). Order matters — see
// _internal/book_audit/p1-rendering.md §gotchas:
//   (a) STASH + protect math spans ($$…$$, \(…\), \[…\]) and code spans (`…`)
//       so markdown/escaping never touch their contents. For MATH we escape
//       only < > & to entities (so KaTeX's textContent stays correct and the
//       browser won't parse a `<b…` as a tag) but KEEP backslashes and `$`.
//       For CODE we emit <code> with fully-escaped contents.
//   (b) HTML-escape the remaining (author) text.
//   (c) **bold** BEFORE *italic* (so a `*` inside `**` can't double-match),
//       then [text](url) links.
//   (d) restore the stashed spans.
// Placeholders use Private-Use-Area sentinels (U+E000 / U+E001), built via
// String.fromCharCode so the source stays ASCII. They cannot occur in author
// text and pass through escAll + the bold/italic/link passes untouched.
const SENT_L = String.fromCharCode(0xE000), SENT_R = String.fromCharCode(0xE001);
const escAll = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const escMath = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); // keep \ and $
function inlineMd(s) {
  if (s == null) return '';
  if (typeof s !== 'string') s = String(s);
  const stash = [];
  const hold = (html) => { stash.push(html); return SENT_L + (stash.length - 1) + SENT_R; };

  // (a) protect math first (display delimiters before inline), then code spans.
  let h = s
    .replace(/\$\$([\s\S]+?)\$\$/g, (_, m) => hold('$$' + escMath(m) + '$$'))
    .replace(/\\\[([\s\S]+?)\\\]/g, (_, m) => hold('\\[' + escMath(m) + '\\]'))
    .replace(/\\\(([\s\S]+?)\\\)/g, (_, m) => hold('\\(' + escMath(m) + '\\)'))
    .replace(/`([^`]+)`/g, (_, m) => hold('<code>' + escAll(m) + '</code>'));

  // (b) escape the remaining author text.
  h = escAll(h);

  // (c) bold BEFORE italic. Bold is non-greedy and allows a *nested* single-`*`
  // italic inside it (e.g. `**… *never seen before*.**`): `[\s\S]+?` stops at the
  // nearest closing `**`, leaving any interior `*…*` for the italic pass below.
  // Then italic (guarded so `**`/stray `*` aren't mis-emphasized), then links.
  h = h.replace(/\*\*([\s\S]+?)\*\*/g, '<strong>$1</strong>');
  h = h.replace(/(^|[^*])\*(?!\s)([^*\n]+?)\*(?!\*)/g, '$1<em>$2</em>');
  // URL may contain balanced parens (SICI-style DOIs like 10.1002/(SICI)...) — match
  // bare chars OR one level of (...) groups, leaving the final ) to close the md link.
  // `<`/`>` in a URL are already &lt;/&gt; here (escAll ran first); the browser decodes
  // them back in the href, so escaped angle brackets link fine.
  h = h.replace(/\[([^\]]+)\]\(((?:[^()\s]|\([^()\s]*\))+)\)/g,
    '<a href="$2" target="_blank" rel="noopener">$1</a>');

  // (d) restore protected spans.
  h = h.replace(new RegExp(SENT_L + '(\\d+)' + SENT_R, 'g'), (_, i) => stash[Number(i)]);
  return h;
}
// vendored KaTeX (same copy the decks ship) — copy-static publishes Lectures/ → docs/Lectures/,
// so these resolve on the live site with zero CDN.
const katexCss = withBase('/Lectures/vendor/katex/katex.min.css');
const katexJs = withBase('/Lectures/vendor/katex/katex.min.js');
const katexAuto = withBase('/Lectures/vendor/katex/auto-render.min.js');
---
<BaseLayout lang={lang} page={`book/${id}`} title={`${chapter.catchphrase} · ${t(course.meta.title, lang)}`}>
  <link rel="stylesheet" href={katexCss} />
  <article class="book">
    <header class="book-head wrap">
      <div class="book-kick">{t(ui.nav.book, lang)} · {lec.id} · {chapter.catchphrase}</div>
      <h1>{t(lec.title, lang)}</h1>
      {showFallbackNotice && <p class="notice">{t(ui.translationInProgress, lang)}</p>}
      <p class="book-xref"><a href={withBase('/' + lec.deckFile)}>{t(ui.labels.openSlides, lang)} →</a></p>
    </header>

    {beats.map((b) => b.kind === 'prose' ? (
      <section class="beat-prose wrap" id={b.id}>
        {b.heading && <h2 set:html={inlineMd(t(b.heading, lang))} />}
        {b.img && (
          <figure class={`beat-figure beat-figure--${b.imgPos || 'scene'}`}>
            <img src={withBase('/Lectures/assets/img/' + b.img)}
                 alt={b.imgAlt ? t(b.imgAlt, lang) : (b.imgCaption ? t(b.imgCaption, lang) : '')}
                 loading="lazy" decoding="async" />
            {b.imgCaption && <figcaption set:html={inlineMd(t(b.imgCaption, lang))} />}
          </figure>
        )}
        {proseText(t(b.body, lang)).map((p) => <p set:html={inlineMd(p)} />)}
      </section>
    ) : (
      <section class="scrolly" id={b.id} data-beat={b.id}>
        <figure class="scrolly-graphic">
          <figcaption class="scrolly-cap">{t(WIDGET_META[b.widget].manifest.title, lang)}</figcaption>
          <div class="cs-mount" id={`fig-${b.id}`}></div>
        </figure>
        <div class="scrolly-steps">
          {b.steps.map((s) => (
            <div class="scroll-step" data-beat={b.id} data-step={s.step}><p>{s.label}</p></div>
          ))}
        </div>
      </section>
    ))}

    <footer class="book-foot wrap">
      <p class="book-xref"><a href={localizedPath(lang)}>← {t(ui.sections.lectures, lang)}</a></p>
    </footer>
  </article>

  <script type="application/json" id="cs-payload" set:html={JSON.stringify(payload)}></script>
  <script>
    import scrollama from 'scrollama';

    // Auto-registered widget mounts: eager-glob every widgets/<id>/logic.js, keyed by folder id.
    // Adding a widget folder is picked up here with ZERO edits (replaces the old 11-line import
    // wall + MOUNT{} map). The export name per widget comes from payload.exports (manifest.export).
    const logicMods = import.meta.glob('../../../../widgets/*/logic.js', { eager: true });
    const MOUNT = {};
    for (const [path, mod] of Object.entries(logicMods)) {
      const id = path.split('/').slice(-2)[0]; // widgets/<id>/logic.js → <id>
      MOUNT[id] = mod; // resolve the specific export per beat below
    }

    const payload = JSON.parse(document.getElementById('cs-payload').textContent);
    const exportsMap = payload.exports || {};
    const figs = {};
    for (const b of payload.beats) {
      const el = document.getElementById('fig-' + b.id);
      const mod = MOUNT[b.widget];
      // pick the manifest-declared export; fall back to the module's single mount* function.
      const fn = mod && (mod[exportsMap[b.widget]] || Object.values(mod).find((v) => typeof v === 'function'));
      if (el && typeof fn === 'function') figs[b.id] = fn(el, { data: b.data, labels: b.labels });
    }
    window.__figs = figs; // headless verification hook

    const sc = scrollama();
    sc.setup({ step: '.scroll-step', offset: 0.6 }).onStepEnter(({ element }) => {
      const f = figs[element.dataset.beat];
      if (f) f.setStep(Number(element.dataset.step));
    });
    addEventListener('resize', () => sc.resize());
  </script>

  <!-- Vendored KaTeX (offline, same copy the decks ship). `defer` preserves order:
       katex.min.js → auto-render.min.js → the render call below. The render script
       also gates on DOMContentLoaded, so it runs after both libs have evaluated.
       Separate from the scrolly module script above — does not interfere with it. -->
  <script defer src={katexJs} is:inline></script>
  <script defer src={katexAuto} is:inline></script>
  <script is:inline>
    (function () {
      function renderBookMath() {
        var root = document.querySelector('.book');
        if (root && typeof window.renderMathInElement === 'function') {
          window.renderMathInElement(root, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '\\(', right: '\\)', display: false },
              { left: '\\[', right: '\\]', display: true }
            ],
            throwOnError: false,
            strict: 'ignore'
          });
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderBookMath);
      } else {
        renderBookMath();
      }
    })();
  </script>

  <!-- global: widget captions/counters are runtime-injected (no Astro scope) — hide in scroll context -->
  <style is:global>
    .scrolly .wgt-caption, .scrolly .wgt-counter,
    .scrolly .cs-caption, .scrolly .cs-counter { display: none; }
  </style>

  <style>
    .book h1 { font-family: var(--font-serif); font-size: var(--fz-h1); margin: 8px 0 14px; }
    .book-kick { font-family: var(--font-mono); font-size: var(--fz-tiny); letter-spacing: 2px;
      text-transform: uppercase; color: var(--warm-ink); }
    .book-head, .book-foot { padding-top: var(--ws-5); padding-bottom: var(--ws-3); }
    .book-xref { font-family: var(--font-mono); font-size: var(--fz-small); margin-top: var(--ws-3); }

    .beat-prose { padding: var(--ws-3) var(--ws-4); overflow-x: clip; }
    .beat-prose h2 { font-family: var(--font-serif); font-size: var(--fz-h2); margin: var(--ws-3) 0 8px; }
    .beat-prose p { font-size: var(--fz-lead); line-height: 1.65; color: var(--ink-2);
      max-width: var(--ws-measure); margin: 0 auto 0 0; }
    .beat-prose p + p { margin-top: var(--ws-2); }

    /* inline markdown emitted by inlineMd(): strong / em / code (readable light + dark). */
    .beat-prose strong, .beat-prose h2 strong, .beat-figure figcaption strong { font-weight: 700; color: var(--ink); }
    .beat-prose em, .beat-figure figcaption em { font-style: italic; }
    .beat-prose code, .beat-figure figcaption code {
      font-family: var(--font-mono); font-size: .9em;
      background: color-mix(in srgb, var(--ink) 8%, transparent);
      border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
      border-radius: 5px; padding: .08em .36em; }

    /* KaTeX display math: centered, breathing room; scroll instead of overflow on long rows. */
    .beat-prose .katex-display { margin: var(--ws-2) 0; padding: 2px 0;
      max-width: 100%; overflow-x: auto; overflow-y: hidden; }
    .beat-prose .katex { font-size: 1.05em; max-width: 100%; }
    /* Long inline formulas can't wrap (KaTeX is nowrap) — let them scroll, never push the page. */
    .beat-prose p .katex { display: inline-block; max-width: 100%; overflow-x: auto;
      overflow-y: hidden; vertical-align: middle; }
    @media (max-width: 640px) {
      .beat-prose .katex-display { font-size: .8em; }
      .beat-prose p .katex { font-size: .95em; }
    }

    /* In-prose illustrations (mascot / scene art). White canvas so off-white art
       reads in dark mode; responsive; never overflows. */
    .beat-figure { margin: var(--ws-3) 0; max-width: var(--ws-measure); }
    .beat-figure img { display: block; width: 100%; height: auto; border-radius: 12px;
      background: #fff; border: 1px solid rgba(0,0,0,.12); }
    .beat-figure figcaption { font-family: var(--font-mono); font-size: var(--fz-tiny);
      letter-spacing: .5px; color: var(--ink-3); margin-top: 8px; max-width: 60ch; }
    .beat-figure--scene { max-width: min(var(--ws-measure), 560px); }
    .beat-figure--hero { max-width: var(--ws-page); margin-left: auto; margin-right: auto; }
    .beat-figure--mascot { max-width: 220px; float: right; margin: 0 0 var(--ws-2) var(--ws-3); }
    @media (max-width: 640px) {
      .beat-figure--mascot { float: none; max-width: min(100%, 300px); margin: var(--ws-3) auto; }
    }

    .scrolly { display: grid; grid-template-columns: var(--ws-book-graphic) 1fr;
      gap: var(--ws-5); max-width: var(--ws-page); margin: var(--ws-5) auto; padding: 0 var(--ws-4); }
    .scrolly-graphic { position: sticky; top: 10vh; align-self: start; min-height: 60vh;
      display: flex; flex-direction: column; justify-content: center; gap: var(--ws-2); margin: 0; }
    .scrolly-cap { font-family: var(--font-mono); font-size: var(--fz-tiny); letter-spacing: 1px;
      text-transform: uppercase; color: var(--ink-3); }
    .cs-mount { width: 100%; }
    .scrolly-steps { display: flex; flex-direction: column; }
    .scroll-step { min-height: 80vh; display: flex; align-items: center; }
    .scroll-step:last-child { min-height: 60vh; }
    .scroll-step p { font-size: var(--fz-lead); line-height: 1.55; color: var(--ink);
      max-width: 46ch; border-left: 3px solid var(--accent-soft); padding-left: var(--ws-3); }

    @media (max-width: 820px) {
      .scrolly { grid-template-columns: 1fr; gap: var(--ws-2); }
      .scrolly-graphic { position: sticky; top: 0; min-height: 0; padding: var(--ws-2) 0;
        background: var(--bg); z-index: 5; box-shadow: 0 6px 12px -8px rgba(0,0,0,.25); }
      .scroll-step { min-height: 70vh; }
    }
  </style>
</BaseLayout>
