---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, t, withBase, localizedPath } from '../../i18n/locales.js';
import { ui } from '../../i18n/ui.js';

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const { lang } = Astro.params;
const showFallbackNotice = lang === 'tt';

// Full assignment content lives here (EN canonical + RU). TT falls back to RU.
const C = {
  en: {
    topic: 'Classical IR & Ranking Metrics — implementing BM25 on a corpus; computing nDCG, MAP, MRR; and analysing how tokenization choices change ranking quality.',
    intro: 'Two assignments turn Lectures 03–04 into working code. The Lab is a small, hands-on build; the Homework is a deeper experimental study plus a paper-reading essay. In both, you implement the core IR algorithms by hand — that is the point.',
    cards: [
      { tag: 'Lab', cls: 'ready', code: 'Lab', title: 'Build BM25 by hand, compare two rankers', blurb: 'Inverted index + TF-IDF + BM25 from scratch on a real judged corpus; compare TF-IDF vs BM25 on a fixed query set with nDCG@10.', meta: 'Small · 1 dataset · ~1 evening' },
      { tag: 'Homework', cls: 'soon', code: 'A1', title: 'Deeper experiments + paper essay', blurb: 'Four rankers, three metrics, a parameter sweep, a tokenization study and a significance test — then read one paper and re-draw its hero figure by hand.', meta: 'Extended · coding + handwritten essay' },
    ],
    rulesH: 'Ground rules (both assignments)',
    rules: [
      'Implement the core IR algorithms by hand: the inverted index, TF-IDF, BM25, RRF, and every metric (nDCG, MAP, MRR). No rank_bm25, no pytrec_eval, no library scorers for the graded parts.',
      'Allowed helpers: dataset loading (ir_datasets / beir / HuggingFace), numpy, plotting libraries, and a tokenizer/stemmer library — but only for the tokenization study, not the core scorer.',
      'Be reproducible: fixed random seed (20260605), fixed query subsets stated below, deterministic output. A grader must reproduce your numbers by re-running.',
      'Submit code that runs end-to-end plus a short report (PDF). State every formula variant you chose (tf scheme, idf form, gain function).',
    ],
    dataH: 'Dataset & fixed queries',
    dataLead: 'Both assignments use BEIR. The Lab uses nfcorpus (≈3.6K docs, 323 test queries, graded qrels); the Homework may additionally repeat the headline run on scifact. Load via ir_datasets:',
    dataCode: `import ir_datasets
ds = ir_datasets.load("beir/nfcorpus/test")     # graded relevance (0..2)
docs    = {d.doc_id: d.text for d in ds.docs_iter()}
queries = {q.query_id: q.text for q in ds.queries_iter()}
qrels   = {}
for qr in ds.qrels_iter():
    qrels.setdefault(qr.query_id, {})[qr.doc_id] = qr.relevance

# Homework deeper run (optional):
# ds = ir_datasets.load("beir/scifact/test")`,
    dataNote: 'Alternatives: the beir package GenericDataLoader, or HuggingFace datasets (BeIR/nfcorpus). Fixed query set: the first 30 test queries sorted by query_id for the Lab; the full test query set for the Homework. If memory is tight, restrict the corpus to documents that appear in any qrel plus a seed-20260605 random sample, and document the subsetting.',
    refH: 'Reference material',
    refLead: 'This builds directly on Lectures 03 (the BM25 saga, the inverted index, RRF) and 04 (nDCG, MAP, MRR, significance, tokenization’s effect on ranking).',

    labH: 'Lab — implement by hand, compare two rankers',
    labGoalH: 'Goal',
    labGoal: 'Implement an inverted index, TF-IDF, and BM25 from scratch on a real judged corpus, then compare TF-IDF against BM25 on a fixed query set and explain — with a concrete example from your own output — where and why they differ.',
    labTasksH: 'Tasks',
    labTasks: [
      'Load BEIR nfcorpus/test and build the fixed query set (first 30 by query_id).',
      'Tokenize with one fixed scheme: lowercase → strip punctuation → split on whitespace. (The Lab holds tokenization fixed; the Homework varies it.)',
      'Build an inverted index from scratch: term → postings [(doc_id, tf)]; also record document lengths and avgdl.',
      'Implement TF-IDF by hand: w(t,d) = tf · log(N/df). State your tf and idf variant; score by summing query-term weights or by cosine (your choice, stated).',
      'Implement BM25 by hand: k₁ = 1.5, b = 0.75, smoothed idf ln(1 + (N−df+0.5)/(df+0.5)). Reuse the same index.',
      'For each query, retrieve the top-10 under TF-IDF and under BM25.',
      'Compute nDCG@10 (by hand, graded gain 2^rel−1, log₂(i+1) discount) per query for both rankers; report the mean for each and show one query where they rank differently.',
      'Write a half-page analysis: where does BM25 diverge from TF-IDF, and why? Point to term-frequency saturation and document-length normalization using your concrete example.',
    ],
    labDelivH: 'Deliverables',
    labDeliv: 'lab.py (or a notebook) that runs end-to-end and prints the comparison table, plus a 1-page report: the mean-nDCG@10 table, one divergent-query table, and the analysis paragraph.',
    labGradeH: 'Grading (100)',
    labGrade: [['Inverted index correct', '20'], ['TF-IDF correct', '20'], ['BM25 correct', '30'], ['nDCG@10 correct', '15'], ['Analysis', '15']],

    hwH: 'Homework — deeper experiments + paper essay',
    hwIntro: 'Build on the Lab. Part 1 is an extended experimental study; Part 2 is a close reading of one paper with a hand-drawn re-interpretation of its hero figure.',
    hwP1H: 'Part 1 — Coding & experiments (60%)',
    hwP1Lead: 'Use BEIR nfcorpus/test over the full test query set (optionally repeat the headline experiment on scifact/test).',
    hwP1: [
      'Rankers (by hand): a Boolean-OR baseline, TF-IDF (cosine), BM25, and RRF fusion (Σ 1/(k+rank), k=60) of BM25 + TF-IDF.',
      'Metrics (by hand): nDCG@10, MAP, MRR over all queries — report the mean and the per-query distribution (box/violin or histogram). Use graded gain 2^rel−1 and the log₂(i+1) discount.',
      'BM25 parameter study: sweep k₁ ∈ {0.5,1.0,1.2,1.5,2.0,3.0} and b ∈ {0,0.25,0.5,0.75,1.0}; plot nDCG@10 vs k₁ (b fixed) and vs b (k₁ fixed); identify the best (k₁,b) and explain the shape (saturation; the b=0/1 extremes).',
      'Tokenization study: compare ≥3 pipelines on the same BM25 — (a) lowercase+whitespace, (b) + stopword removal, (c) + Porter stemming, (optional d) subword/BPE. Report nDCG@10 / MAP / MRR for each and explain why each choice helps or hurts (vocabulary size, df shifts, conflation vs over-conflation). Tie back to Lecture 02 (tokenization) and 03 (idf/df).',
      'Statistical significance: is your best system better than the BM25 baseline, or is it chance? Run a paired test (t-test and/or Wilcoxon signed-rank) on per-query nDCG@10; report the mean difference, a 95% CI, and the p-value, and interpret it (necessary-not-sufficient; the small-n caveat).',
      'Report: plots + tables + a discussion connecting the parameter sweep, the tokenization study, and the significance test into one story about what actually moves ranking quality.',
    ],
    hwP1GradeH: 'Part 1 grading (60)',
    hwP1Grade: [['Four rankers correct', '15'], ['Three metrics correct', '15'], ['Parameter study + plots', '10'], ['Tokenization study', '12'], ['Significance', '8']],

    hwP2H: 'Part 2 — Paper reading & hand-written essay (40%)',
    hwP2Lead: 'Pick one of the five papers below, read it closely, and write a two-page A4 hand-written essay in your own words — your interpretation, not a summary. Then complete the hero-figure sub-task.',
    heroH: 'Hero-figure sub-task',
    hero: 'Identify the paper’s hero figure — the one diagram that carries its central idea. Redesign it your own way (hand-drawn is fine) to expose the concept more deeply than the original: change the encoding, add the missing axis or annotation, show the failure case, or re-draw it using your own Lab/Homework numbers. Add a short caption stating what your version makes visible that the original did not.',
    subH: 'Submission',
    sub: 'A photo/scan of the two-page hand-written essay, the redesigned hero figure (hand-drawn or digital), and one paragraph naming the figure you chose and why it is the hero figure.',
    papersH: 'Choose one paper',
    papers: [
      { cite: 'Spärck Jones, K. (1972). A Statistical Interpretation of Term Specificity and Its Application in Retrieval. Journal of Documentation.', hero: 'The origin of IDF. Hero figure: the term-specificity / frequency relationship.' },
      { cite: 'Robertson, S. & Zaragoza, H. (2009). The Probabilistic Relevance Framework: BM25 and Beyond. Foundations & Trends in IR.', hero: 'The definitive BM25 treatment. Hero figure: the term-frequency saturation curve(s).' },
      { cite: 'Singhal, A., Buckley, C. & Mitra, M. (1996). Pivoted Document Length Normalization. SIGIR.', hero: 'Hero figure: P(relevance) vs P(retrieval) as a function of document length — the crossing curves that motivate the b parameter.' },
      { cite: 'Järvelin, K. & Kekäläinen, J. (2002). Cumulated Gain-based Evaluation of IR Techniques. ACM TOIS.', hero: 'The (n)DCG paper. Hero figure: cumulated and discounted gain curves across rank.' },
      { cite: 'Cormack, G. V., Clarke, C. L. A. & Büttcher, S. (2009). Reciprocal Rank Fusion Outperforms Condorcet and Individual Rank Learning Methods. SIGIR.', hero: 'RRF. Hero element: the RRF formula and its results table — redesign it as a figure.' },
    ],
    hwP2GradeH: 'Part 2 grading (40)',
    hwP2Grade: [['Interpretation depth & correctness', '20'], ['Hero-figure redesign (insight added)', '15'], ['Clarity, structure, handwriting', '5']],

    logiH: 'Logistics',
    logi: 'Deadlines follow the course schedule. Submit code + report PDF (Part 1) and the scanned essay + figure (Part 2). Late and collaboration policy per the syllabus.',
  },

  ru: {
    topic: 'Классический IR и метрики ранжирования — реализация BM25 на корпусе; подсчёт nDCG, MAP, MRR; анализ влияния выбора токенизации на качество ранжирования.',
    intro: 'Два задания превращают лекции 03–04 в работающий код. Лаба — небольшая практическая сборка; домашка — более глубокое экспериментальное исследование плюс эссе по статье. В обоих случаях ключевые алгоритмы IR вы реализуете руками — в этом и смысл.',
    cards: [
      { tag: 'Лаба', cls: 'ready', code: 'Lab', title: 'BM25 руками, сравнение двух ранжировщиков', blurb: 'Инвертированный индекс + TF-IDF + BM25 с нуля на реальном judged-корпусе; сравнение TF-IDF и BM25 на фиксированном наборе запросов по nDCG@10.', meta: 'Небольшая · 1 датасет · ~вечер' },
      { tag: 'Домашка', cls: 'soon', code: 'A1', title: 'Глубже эксперименты + эссе по статье', blurb: 'Четыре ранжировщика, три метрики, свип параметров, исследование токенизации и тест значимости — затем прочитать статью и перерисовать её hero-фигуру рукой.', meta: 'Расширенная · код + рукописное эссе' },
    ],
    rulesH: 'Общие правила (оба задания)',
    rules: [
      'Ключевые алгоритмы IR реализуйте руками: инвертированный индекс, TF-IDF, BM25, RRF и все метрики (nDCG, MAP, MRR). Без rank_bm25, pytrec_eval и библиотечных скореров в оцениваемых частях.',
      'Разрешено: загрузка датасета (ir_datasets / beir / HuggingFace), numpy, библиотеки графиков и токенизатор/стеммер — но только для исследования токенизации, не для ядра скорера.',
      'Воспроизводимость: фиксированный seed (20260605), фиксированные поднаборы запросов (ниже), детерминированный вывод. Проверяющий должен воспроизвести ваши числа повторным запуском.',
      'Сдавайте код, работающий от начала до конца, плюс краткий отчёт (PDF). Укажите все выбранные варианты формул (схема tf, форма idf, gain-функция).',
    ],
    dataH: 'Датасет и фиксированные запросы',
    dataLead: 'Оба задания используют BEIR. Лаба — nfcorpus (≈ 3,6 тыс. документов, 323 test-запроса, градуированные qrels); в домашке можно дополнительно повторить основной прогон на scifact. Загрузка через ir_datasets:',
    dataCode: `import ir_datasets
ds = ir_datasets.load("beir/nfcorpus/test")     # градуированная релевантность (0..2)
docs    = {d.doc_id: d.text for d in ds.docs_iter()}
queries = {q.query_id: q.text for q in ds.queries_iter()}
qrels   = {}
for qr in ds.qrels_iter():
    qrels.setdefault(qr.query_id, {})[qr.doc_id] = qr.relevance

# Глубокий прогон для домашки (опционально):
# ds = ir_datasets.load("beir/scifact/test")`,
    dataNote: 'Альтернативы: пакет beir (GenericDataLoader) или HuggingFace datasets (BeIR/nfcorpus). Фиксированный набор запросов: первые 30 test-запросов по возрастанию query_id для Лабы; полный test-набор для домашки. Если мало памяти — ограничьте корпус документами из qrels плюс случайная выборка с seed 20260605 и опишите это.',
    refH: 'Справочный материал',
    refLead: 'Это прямое продолжение лекций 03 (сага BM25, инвертированный индекс, RRF) и 04 (nDCG, MAP, MRR, значимость, влияние токенизации на ранжирование).',

    labH: 'Лаба — реализация руками, сравнение двух ранжировщиков',
    labGoalH: 'Цель',
    labGoal: 'Реализовать инвертированный индекс, TF-IDF и BM25 с нуля на реальном judged-корпусе, затем сравнить TF-IDF и BM25 на фиксированном наборе запросов и объяснить — на конкретном примере из своего вывода — где и почему они расходятся.',
    labTasksH: 'Задачи',
    labTasks: [
      'Загрузите BEIR nfcorpus/test и постройте фиксированный набор запросов (первые 30 по query_id).',
      'Токенизация одной фиксированной схемой: нижний регистр → убрать пунктуацию → разбиение по пробелам. (В Лабе токенизация фиксирована; в домашке варьируется.)',
      'Постройте инвертированный индекс с нуля: терм → postings [(doc_id, tf)]; запишите длины документов и avgdl.',
      'Реализуйте TF-IDF руками: w(t,d) = tf · log(N/df). Укажите вариант tf и idf; скоринг — сумма весов термов запроса или косинус (на ваш выбор, укажите).',
      'Реализуйте BM25 руками: k₁ = 1.5, b = 0.75, сглаженный idf ln(1 + (N−df+0.5)/(df+0.5)). Тот же индекс.',
      'Для каждого запроса выдайте top-10 по TF-IDF и по BM25.',
      'Посчитайте nDCG@10 (руками, gain 2^rel−1, дисконт log₂(i+1)) по каждому запросу для обоих; дайте среднее и покажите запрос, где ранжирование различается.',
      'Напишите полстраницы анализа: где BM25 расходится с TF-IDF и почему? Сошлитесь на насыщение tf и нормировку длины на своём примере.',
    ],
    labDelivH: 'Что сдавать',
    labDeliv: 'lab.py (или notebook), работающий от начала до конца и печатающий таблицу сравнения, плюс отчёт на 1 страницу: таблица среднего nDCG@10, таблица расходящегося запроса и абзац анализа.',
    labGradeH: 'Оценка (100)',
    labGrade: [['Инвертированный индекс', '20'], ['TF-IDF', '20'], ['BM25', '30'], ['nDCG@10', '15'], ['Анализ', '15']],

    hwH: 'Домашка — глубже эксперименты + эссе по статье',
    hwIntro: 'На основе Лабы. Часть 1 — расширенное экспериментальное исследование; часть 2 — внимательное чтение одной статьи с рукописной переинтерпретацией её hero-фигуры.',
    hwP1H: 'Часть 1 — Код и эксперименты (60%)',
    hwP1Lead: 'BEIR nfcorpus/test на полном test-наборе запросов (опционально повторите основной эксперимент на scifact/test).',
    hwP1: [
      'Ранжировщики (руками): Boolean-OR базлайн, TF-IDF (косинус), BM25 и RRF-фьюжн (Σ 1/(k+rank), k=60) BM25 + TF-IDF.',
      'Метрики (руками): nDCG@10, MAP, MRR по всем запросам — среднее и распределение по запросам (box/violin или гистограмма). gain 2^rel−1, дисконт log₂(i+1).',
      'Свип параметров BM25: k₁ ∈ {0.5,1.0,1.2,1.5,2.0,3.0}, b ∈ {0,0.25,0.5,0.75,1.0}; графики nDCG@10 от k₁ (b фикс.) и от b (k₁ фикс.); найдите лучшую (k₁,b) и объясните форму (насыщение; крайние b=0/1).',
      'Исследование токенизации: сравните ≥3 пайплайна на одном BM25 — (a) нижний регистр+пробелы, (b) + удаление стоп-слов, (c) + стемминг Портера, (опц. d) subword/BPE. nDCG@10 / MAP / MRR для каждого и объяснение, почему помогает/вредит (размер словаря, сдвиги df, конфляция). Свяжите с лекциями 02 и 03.',
      'Статистическая значимость: лучшая система действительно лучше BM25-базлайна или это случайность? Парный тест (t-test и/или Wilcoxon) по per-query nDCG@10; средняя разница, 95% CI, p-value и интерпретация (необходимо-но-недостаточно; малое n).',
      'Отчёт: графики + таблицы + обсуждение, связывающее свип, токенизацию и значимость в одну историю о том, что реально двигает качество.',
    ],
    hwP1GradeH: 'Оценка части 1 (60)',
    hwP1Grade: [['Четыре ранжировщика', '15'], ['Три метрики', '15'], ['Свип + графики', '10'], ['Токенизация', '12'], ['Значимость', '8']],

    hwP2H: 'Часть 2 — Чтение статьи и рукописное эссе (40%)',
    hwP2Lead: 'Выберите одну из пяти статей ниже, внимательно прочитайте и напишите рукописное эссе на две страницы A4 своими словами — ваша интерпретация, не пересказ. Затем выполните подзадачу с hero-фигурой.',
    heroH: 'Подзадача: hero-фигура',
    hero: 'Определите hero-фигуру статьи — диаграмму, несущую её центральную идею. Перерисуйте её по-своему (можно от руки), чтобы раскрыть концепт глубже оригинала: смените кодировку, добавьте недостающую ось/подпись, покажите случай отказа или перерисуйте её на своих числах из Лабы/домашки. Добавьте короткую подпись — что ваш вариант делает видимым, чего не было в оригинале.',
    subH: 'Что сдавать',
    sub: 'Фото/скан рукописного эссе на две страницы A4, перерисованная hero-фигура (от руки или цифровая) и один абзац — какую фигуру выбрали и почему она hero.',
    papersH: 'Выберите одну статью',
    papers: [
      { cite: 'Spärck Jones, K. (1972). A Statistical Interpretation of Term Specificity and Its Application in Retrieval. Journal of Documentation.', hero: 'Происхождение IDF. Hero-фигура: связь специфичности терма и частоты.' },
      { cite: 'Robertson, S. & Zaragoza, H. (2009). The Probabilistic Relevance Framework: BM25 and Beyond. Foundations & Trends in IR.', hero: 'Определяющий труд по BM25. Hero-фигура: кривая насыщения tf.' },
      { cite: 'Singhal, A., Buckley, C. & Mitra, M. (1996). Pivoted Document Length Normalization. SIGIR.', hero: 'Hero-фигура: P(релевантность) против P(выдачи) от длины документа — пересекающиеся кривые, мотивирующие параметр b.' },
      { cite: 'Järvelin, K. & Kekäläinen, J. (2002). Cumulated Gain-based Evaluation of IR Techniques. ACM TOIS.', hero: 'Статья про (n)DCG. Hero-фигура: кривые cumulated/discounted gain по рангу.' },
      { cite: 'Cormack, G. V., Clarke, C. L. A. & Büttcher, S. (2009). Reciprocal Rank Fusion Outperforms Condorcet and Individual Rank Learning Methods. SIGIR.', hero: 'RRF. Hero-элемент: формула RRF и таблица результатов — перерисуйте как фигуру.' },
    ],
    hwP2GradeH: 'Оценка части 2 (40)',
    hwP2Grade: [['Глубина и корректность интерпретации', '20'], ['Перерисовка hero-фигуры (добавленный инсайт)', '15'], ['Ясность, структура, почерк', '5']],

    logiH: 'Организация',
    logi: 'Дедлайны — по расписанию курса. Сдача: код + отчёт PDF (часть 1) и скан эссе + фигура (часть 2). Политика просрочек и сотрудничества — по программе.',
  },
};
const c = C[lang] || C.ru || C.en;
const dl3book = localizedPath(lang, 'book/03');
const dl4book = localizedPath(lang, 'book/04');
const dl3deck = withBase('/Lectures/03-classical-ir-fulltext-fusion.html');
const dl4deck = withBase('/Lectures/04-ranking-metrics.html');
---
<BaseLayout lang={lang} page="assignments" title={t(ui.nav.assignments, lang)}>
  <div class="wrap">
    <section class="block">
      <h2>{t(ui.sections.assignments, lang)}</h2>
      <div class="kicker">{t(ui.sections.assignmentsKicker, lang)}</div>
      {showFallbackNotice && <p class="notice">{t(ui.translationInProgress, lang)}</p>}
      <p class="lead">{c.intro}</p>
      <p class="topic"><strong>{c.topic}</strong></p>

      <div class="cards">
        {c.cards.map((a) => (
          <div class={`card ${a.cls === 'soon' ? 'soon' : ''}`}>
            <span class={`tag ${a.cls}`}>{a.tag}</span>
            <div class="num">{a.code}</div>
            <h3>{a.title}</h3>
            <p>{a.blurb}</p>
            <div class="when">{a.meta}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="block">
      <h3>{c.rulesH}</h3>
      <ul class="reading">{c.rules.map((r) => <li>{r}</li>)}</ul>
    </section>

    <section class="block">
      <h3>{c.dataH}</h3>
      <p>{c.dataLead}</p>
      <pre><code>{c.dataCode}</code></pre>
      <p class="muted">{c.dataNote}</p>
      <h4>{c.refH}</h4>
      <p>{c.refLead}</p>
      <div class="links">
        <a href={dl3book}>L03 · {t(ui.labels.readBook, lang)}</a>
        <a href={dl3deck}>L03 · {t(ui.labels.openSlides, lang)}</a>
        <a href={dl4book}>L04 · {t(ui.labels.readBook, lang)}</a>
        <a href={dl4deck}>L04 · {t(ui.labels.openSlides, lang)}</a>
      </div>
    </section>

    <section class="block">
      <h2>{c.labH}</h2>
      <h4>{c.labGoalH}</h4>
      <p>{c.labGoal}</p>
      <h4>{c.labTasksH}</h4>
      <ol class="steps">{c.labTasks.map((x) => <li>{x}</li>)}</ol>
      <h4>{c.labDelivH}</h4>
      <p>{c.labDeliv}</p>
      <h4>{c.labGradeH}</h4>
      <table class="grade">
        <tbody>
          {c.labGrade.map((row) => <tr><td>{row[0]}</td><td class="w">{row[1]}</td></tr>)}
        </tbody>
      </table>
    </section>

    <section class="block">
      <h2>{c.hwH}</h2>
      <p class="lead">{c.hwIntro}</p>

      <h3>{c.hwP1H}</h3>
      <p>{c.hwP1Lead}</p>
      <ol class="steps">{c.hwP1.map((x) => <li>{x}</li>)}</ol>
      <h4>{c.hwP1GradeH}</h4>
      <table class="grade">
        <tbody>
          {c.hwP1Grade.map((row) => <tr><td>{row[0]}</td><td class="w">{row[1]}</td></tr>)}
        </tbody>
      </table>

      <h3>{c.hwP2H}</h3>
      <p>{c.hwP2Lead}</p>
      <div class="notice"><strong>{c.heroH}.</strong> {c.hero}</div>
      <h4>{c.subH}</h4>
      <p>{c.sub}</p>
      <h4>{c.papersH}</h4>
      <ol class="papers">
        {c.papers.map((p) => (
          <li><span class="cite">{p.cite}</span><span class="phero">{p.hero}</span></li>
        ))}
      </ol>
      <h4>{c.hwP2GradeH}</h4>
      <table class="grade">
        <tbody>
          {c.hwP2Grade.map((row) => <tr><td>{row[0]}</td><td class="w">{row[1]}</td></tr>)}
        </tbody>
      </table>
    </section>

    <section class="block">
      <h3>{c.logiH}</h3>
      <p>{c.logi}</p>
    </section>
  </div>

  <style>
    .lead { font-size: var(--fz-lead); color: var(--ink-2); max-width: var(--ws-measure); }
    .topic { max-width: var(--ws-measure); }
    .block p, .block li { max-width: var(--ws-measure); }
    pre {
      background: var(--bg-alt); border: 1px solid var(--rule);
      border-radius: var(--r-md); padding: var(--ws-3); overflow-x: auto;
      font-family: var(--font-mono); font-size: var(--fz-small); line-height: 1.5;
    }
    pre code { font-family: var(--font-mono); white-space: pre; }
    .muted { color: var(--ink-3); font-size: var(--fz-small); }
    ol.steps, ol.papers { padding-left: 1.4em; }
    ol.steps li { margin: 0.5em 0; }
    ol.papers li { margin: 0.8em 0; }
    ol.papers .cite { display: block; font-weight: 600; }
    ol.papers .phero { display: block; color: var(--ink-3); font-size: var(--fz-small); margin-top: 0.15em; }
    table.grade { border-collapse: collapse; margin-top: var(--ws-2); }
    table.grade td { border-bottom: 1px solid var(--rule); padding: 0.35em 1.5em 0.35em 0; }
    table.grade td.w { text-align: right; font-family: var(--font-mono); color: var(--accent); padding-right: 0; }
    .links { display: flex; flex-wrap: wrap; gap: var(--ws-2); margin-top: var(--ws-2); }
    .links a { font-size: var(--fz-small); }
  </style>
</BaseLayout>
