{
  "id": "pq-quantize",
  "version": "1.0.0",
  "title": { "en": "Product quantization: 32 bytes → 4 bytes", "ru": "Product-квантизация: 32 байта → 4 байта", "tt": "Product-квантизация: 32 байт → 4 байт" },
  "maxStep": 3,
  "data": ["l9-pq"],
  "i18n": "widgets/pq-quantize/i18n.json",
  "export": "mountPqQuantize",
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "formula", "driver": "deck-step" } }
}
