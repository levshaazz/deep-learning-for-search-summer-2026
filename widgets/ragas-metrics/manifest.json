{
  "id": "ragas-metrics",
  "version": "1.0.0",
  "title": { "en": "RAGAS: the four metrics", "ru": "RAGAS: четыре метрики", "tt": "RAGAS: дүрт метрика" },
  "maxStep": 4,
  "data": ["l11-ragas"],
  "i18n": "widgets/ragas-metrics/i18n.json",
  "export": "mountRagasMetrics",
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" },
    { "step": 4, "labelKey": "s4" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "walkthrough", "driver": "deck-step" } }
}
