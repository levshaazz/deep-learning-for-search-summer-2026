{
  "id": "graphrag",
  "version": "1.0.0",
  "title": { "en": "GraphRAG: multi-hop traversal", "ru": "GraphRAG: многошаговый обход", "tt": "GraphRAG: күпадымлы үтү" },
  "maxStep": 4,
  "data": ["l12-graphrag"],
  "i18n": "widgets/graphrag/i18n.json",
  "export": "mountGraphrag",
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" },
    { "step": 4, "labelKey": "s4" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "archflow", "driver": "deck-step" } }
}
