{
  "id": "bpe-steps",
  "version": "1.0.0",
  "title": { "en": "BPE training loop, step by step", "ru": "Цикл обучения BPE, шаг за шагом", "tt": "BPE өйрәнү циклы, адымлап" },
  "maxStep": 9,
  "data": ["l2-bpe-steps"],
  "i18n": "widgets/bpe-steps/i18n.json",
