{
  "id": "cosine-compute",
  "version": "1.0.0",
  "title": { "en": "Cosine, computed step by step", "ru": "Косинус, вычисляемый шаг за шагом", "tt": "Косинус, адымлап исәпләнгән" },
  "maxStep": 3,
  "data": ["l2-cosine"],
  "i18n": "widgets/cosine-compute/i18n.json",
  "export": "mountCosineCompute",
  "protectedTerms": ["cosine", "cos"],
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "e2e", "driver": "deck-step" } }
}
