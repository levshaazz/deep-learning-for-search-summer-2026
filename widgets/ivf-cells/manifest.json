{
  "id": "ivf-cells",
  "version": "1.0.0",
  "title": { "en": "IVF: probe the nearest cells, recall vs nprobe", "ru": "IVF: пробуем ближайшие ячейки, полнота против nprobe", "tt": "IVF: иң якын күзәнәкләрне тикшерү, recall һәм nprobe" },
  "maxStep": 3,
  "data": ["l9-ivf"],
  "i18n": "widgets/ivf-cells/i18n.json",
  "export": "mountIvfCells",
  "_variants": { "toy": "default 9-point/3-cell probe (steps 0..3 via s0..s3)", "toy2": "20-point/5-cell nprobe 1..5 sweep, selected by labels.variant==='toy2' (steps 0..6 via t0..t6)" },
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" }
  ],
  "stepsToy2": [
    { "step": 0, "labelKey": "t0" }, { "step": 1, "labelKey": "t1" },
    { "step": 2, "labelKey": "t2" }, { "step": 3, "labelKey": "t3" },
    { "step": 4, "labelKey": "t4" }, { "step": 5, "labelKey": "t5" }, { "step": 6, "labelKey": "t6" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "viz", "driver": "deck-step" } }
}
