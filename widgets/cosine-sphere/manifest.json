{
  "id": "cosine-sphere",
  "version": "1.0.0",
  "title": { "en": "Cosine on the unit sphere", "ru": "Косинус на единичной сфере", "tt": "Берәмлек сферасында косинус" },
  "maxStep": 4,
  "coordSpace": { "w": 520, "h": 360 },
  "data": ["l2-cosine"],
  "i18n": "widgets/cosine-sphere/i18n.json",
  "protectedTerms": ["cosine", "Euclidean", "L2", "cos"],
  "a11y": { "role": "img", "altKey": "alt" },
  "steps": [
    { "step": 0, "labelKey": "s0", "focus": "two-vectors",  "reads": null },
    { "step": 1, "labelKey": "s1", "focus": "euclid-ruler", "reads": "euclid" },
    { "step": 2, "labelKey": "s2", "focus": "angle-theta",  "reads": "cos" },
    { "step": 3, "labelKey": "s3", "focus": "unit-sphere",  "reads": "normalize" },
    { "step": 4, "labelKey": "s4", "focus": "identity",     "reads": "relation" }
  ],
  "mounts": {
    "slide": { "dataType": "e2e", "driver": "deck-step", "proof": "widgets/cosine-sphere/demo-slide.html" },
    "book":  { "island": "client:visible", "driver": "scrollama", "proof": "src/pages/[lang]/book/[id].astro" }
  },
  "_contract": "REFERENCE_IMPL_L2.md a.6 — driver-agnostic (setStep/maxStep, no input binding); one data source (data/l2-cosine.json); one maxStep for both drivers; i18n by key; protected terms stay Latin."
}
