{
  "id": "cone-dial",
  "version": "1.0.0",
  "title": { "en": "The cone dial", "ru": "Ручка конуса", "tt": "Конус тоткасы" },
  "maxStep": 4,
  "data": ["l18-geometry"],
  "i18n": "widgets/cone-dial/i18n.json",
  "export": "mountConeDial",
  "protectedTerms": ["cos", "SNR"],
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" },
    { "step": 4, "labelKey": "s4" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "viz", "driver": "deck-step" } }
}
