{
  "id": "hnsw-graph",
  "version": "1.0.0",
  "title": { "en": "HNSW: greedy search on a small-world graph", "ru": "HNSW: жадный поиск по графу «тесного мира»", "tt": "HNSW: «тыгыз дөнья» графы буенча комсыз эзләү" },
  "maxStep": 3,
  "data": ["l9-hnsw"],
  "i18n": "widgets/hnsw-graph/i18n.json",
  "export": "mountHnswGraph",
  "_variants": { "toy": "default 6-node single-layer greedy (steps 0..3 via s0..s3)", "toy2": "12-node 2-layer climb, selected by labels.variant==='toy2' (steps 0..5 via t0..t5)" },
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" }
  ],
  "stepsToy2": [
    { "step": 0, "labelKey": "t0" }, { "step": 1, "labelKey": "t1" },
    { "step": 2, "labelKey": "t2" }, { "step": 3, "labelKey": "t3" },
    { "step": 4, "labelKey": "t4" }, { "step": 5, "labelKey": "t5" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "archflow", "driver": "deck-step" } }
}
