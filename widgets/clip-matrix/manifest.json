{
  "id": "clip-matrix",
  "version": "1.0.0",
  "title": { "en": "CLIP: the shared-space matrix", "ru": "CLIP: матрица общего пространства", "tt": "CLIP: уртак киңлек матрицасы" },
  "maxStep": 4,
  "data": ["l12-clip"],
  "i18n": "widgets/clip-matrix/i18n.json",
  "export": "mountClipMatrix",
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" },
    { "step": 4, "labelKey": "s4" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "viz", "driver": "deck-step" } }
}
