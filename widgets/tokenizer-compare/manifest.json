{
  "id": "tokenizer-compare",
  "version": "1.0.0",
  "title": { "en": "Tokenizer compare — four cutters, one input", "ru": "Сравнение токенизаторов — четыре резака, один вход", "tt": "Токенлаштыргычларны чагыштыру — дүрт кискеч, бер керем" },
  "maxStep": 5,
  "data": ["l2-tokenizers"],
  "i18n": "widgets/tokenizer-compare/i18n.json",
  "export": "mountTokenizerCompare",
  "protectedTerms": ["BPE", "WordPiece", "Unigram"],
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" },
    { "step": 4, "labelKey": "s4" }, { "step": 5, "labelKey": "s5" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "e2e", "driver": "deck-step" } }
}
