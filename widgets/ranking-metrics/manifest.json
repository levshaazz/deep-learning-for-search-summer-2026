{
  "id": "ranking-metrics",
  "version": "1.0.0",
  "title": { "en": "Ranking metrics", "ru": "Метрики ранжирования" },
  "maxStep": 4,
  "data": ["l4-metrics"],
  "i18n": "widgets/ranking-metrics/i18n.json",
  "export": "mountRankingMetrics",
  "protectedTerms": ["Recall", "Precision", "MRR", "MAP", "nDCG", "DCG", "IDCG"],
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" },
    { "step": 4, "labelKey": "s4" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "e2e", "driver": "deck-step" } }
}
