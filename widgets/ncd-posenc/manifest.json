{
  "id": "ncd-posenc",
  "version": "1.0.0",
  "title": {
    "en": "Positional encoding as a neural circuit diagram",
    "ru": "Позиционное кодирование как neural circuit diagram",
    "tt": "Позицион кодлау neural circuit diagram буларак"
  },
  "maxStep": 2,
  "data": ["l15-attention"],
  "i18n": "widgets/ncd-posenc/i18n.json",
  "export": "mountNcdPosenc",
  "steps": [
    { "step": 0, "labelKey": "s0" },
    { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "ncd-posenc", "driver": "deck-step" } }
}
