{
  "id": "in-batch-negatives",
  "version": "1.0.0",
  "title": { "en": "In-batch negatives (InfoNCE)", "ru": "Негативы из батча (InfoNCE)", "tt": "Батчтан негативлар (InfoNCE)" },
  "maxStep": 3,
  "data": ["l7-train"],
  "i18n": "widgets/in-batch-negatives/i18n.json",
  "export": "mountInBatchNegatives",
