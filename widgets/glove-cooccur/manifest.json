{
  "id": "glove-cooccur",
  "version": "1.0.0",
  "title": { "en": "GloVe: factorise the co-occurrence matrix", "ru": "GloVe: факторизация матрицы совстречаемости", "tt": "GloVe: бергә очрашу матрицасын факторлау" },
  "maxStep": 4,
  "data": ["l5-glove"],
  "i18n": "widgets/glove-cooccur/i18n.json",
  "export": "mountGloveCooccur",
  "protectedTerms": ["GloVe", "word2vec", "PCA", "PMI"],
  "steps": [
    { "step": 0, "labelKey": "s0" }, { "step": 1, "labelKey": "s1" },
    { "step": 2, "labelKey": "s2" }, { "step": 3, "labelKey": "s3" },
    { "step": 4, "labelKey": "s4" }
  ],
  "mounts": { "book": { "driver": "scrollama" }, "slide": { "dataType": "viz", "driver": "deck-step" } }
}
