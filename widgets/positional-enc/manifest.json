  "title": { "en": "Sinusoidal positional encoding: sin/cos(pos/10000^{2i/d})", "ru": "Синусоидальное позиционное кодирование: sin/cos(pos/10000^{2i/d})", "tt": "Синусоидаль позиция кодлау: sin/cos(pos/10000^{2i/d})" },
